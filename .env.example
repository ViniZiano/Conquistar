# Dados de contato públicos da clínica.
# Informe o WhatsApp com DDI + DDD + número, somente números.
NEXT_PUBLIC_CLINIC_WHATSAPP=
NEXT_PUBLIC_CLINIC_PHONE=
NEXT_PUBLIC_CLINIC_EMAIL=
NEXT_PUBLIC_CLINIC_ADDRESS=
NEXT_PUBLIC_CLINIC_HOURS=

# Configuração inicial local (use somente para criar o primeiro administrador).
# Gere um token aleatório com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Depois de criar o administrador, remova esta variável do .env.local.
CONQUISTAR_BOOTSTRAP_TOKEN=
